{
  "name": "recouvrement-prjt",
  "private": true,
  "description": "Portail Al Omrane — backend Spring Boot + frontend Vite",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:all": "concurrently -n spring,vite -c cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
